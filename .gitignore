# Gradle / Android 构建产物
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.cxx/
.idea/
*.iml

# 本地打包出来的 PWA 压缩包，不进仓库
qingkebiao-pwa.zip

# 放在项目目录里方便拷到手机的 APK，不进仓库
*.apk

# 杂项
.DS_Store
Thumbs.db

# 传 Cloudflare 的那个文件夹里有 APK，不进仓库（模板在 release/）
cloudflare-upload/

# 发布签名：keystore 和口令都不进仓库。丢了就没法给已安装用户推更新了，
# 这两样必须单独备份。
android/keystore.properties
android/qingkebiao-release.jks

# 兜底：任何 keystore / 密码文件都不许进仓库，不管放在哪个目录
*.jks
*.keystore
!android/debug.keystore
**/keystore.properties
*签名备份*
